# Copy this file to `.env` (gitignored). That file is what `npm run dev`,
# `next build` and `next start` read. There is only ONE Supabase project, so `.env`
# with real values means production — a local dev server writes real registrations.
# See docs/DEV-SETUP.md.

# Supabase project (publishable / anon key is safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://<your-project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Admin access is granted per-account via the Supabase Auth admin role
# (account_roles.role = 'admin') — there is no admin passphrase. Grant an account
# admin in SQL: insert into account_roles(account_id, role) values ('<uid>','admin').

# Optional: default merchant QR for single-operator setups. Paste a static Thai
# QR / PromptPay payload (e.g. exported from KBank "K SHOP", starts with
# 00020101…). When set, new tournaments default to this receiver and the app
# injects the amount per registration. Leave blank only if every tournament will
# carry its own pasted merchant QR — merchant QR is the sole payment target
# (the phone / national-id PromptPay flow was removed), so with this blank the
# tournament form refuses to save until a valid QR payload is pasted in.
NEXT_PUBLIC_DEFAULT_MERCHANT_QR=
